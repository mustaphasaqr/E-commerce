{
  "name": "ecommerce-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test auth-professional.spec.ts --project=chromium --project=\"Mobile Chrome\" --project=iPad",
    "test:auth:quick": "playwright test auth-professional.spec.ts --project=chromium",
    "test:auth:report": "playwright test auth-professional.spec.ts --project=chromium --project=\"Mobile Chrome\" --project=iPad --reporter=html && playwright show-report",
    "test:auth:debug": "playwright test auth-professional.spec.ts --debug"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.1.0",
    "@tanstack/react-query": "^5.0.0-beta.35",
    "@types/react-redux": "^7.1.33",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.7",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-redux": "^9.1.0",
    "react-responsive": "^9.0.2",
    "react-router": "^6.21.3",
    "react-router-dom": "^6.21.3",
    "react-spring": "^9.7.3",
    "react-toastify": "^10.0.4",
    "swiper": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.37",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "sass": "^1.70.0",
    "terser": "^5.46.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
