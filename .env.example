# SendGrid Configuration (Required✅)
# Sign up at: https://signup.sendgrid.com
# Get API key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_email@example.com
SENDGRID_FROM_NAME=E-Commerce Platform

# Java Home (Required)
JAVA_HOME=C:\Program Files\Java\jdk-21.0.10

# AWS S3 (Optional⚠️ - falls back to local storage)
# Needed for production only. Local storage works for development.
# Sign up at: https://aws.amazon.com/free/
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET_NAME=your_bucket_name
# AWS_S3_REGION=eu-central-1

# Accept (Paymob) Payment Gateway (Optional⚠️ - uses mock mode in development)
# For REAL payment processing, get credentials from Accept dashboard
# Without credentials, payment runs in MOCK MODE (simulated payments)
# Sign up at: https://accept.paymob.com/portal/en/register (Egypt, Saudi Arabia, UAE, etc.)
# Get test credentials instantly from Accept dashboard > Settings > Account Info
ACCEPT_API_KEY=
ACCEPT_INTEGRATION_ID=
ACCEPT_BASE_URL=https://accept.paymob.com/api
