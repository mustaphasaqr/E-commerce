# SendGrid Configuration (Required✅)
# Sign up at: https://signup.sendgrid.com
# Get API key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_email@example.com
SENDGRID_FROM_NAME=E-Commerce Platform

# Java Home (Required)
JAVA_HOME=C:\Program Files\Java\jdk-21.0.10

# AWS S3 (Optional⚠️ - falls back to local storage)
# Needed for production only. Local storage works for development.
# Sign up at: https://aws.amazon.com/free/
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET_NAME=your_bucket_name
# AWS_S3_REGION=eu-central-1

# Accept (Paymob) Payment Gateway (Optional⚠️ - uses mock mode in development)
# For REAL payment processing, get credentials from Accept dashboard
# Without credentials, payment runs in MOCK MODE (simulated payments)
# Sign up at: https://accept.paymob.com/portal/en/register (Egypt, Saudi Arabia, UAE, etc.)
# Get test credentials instantly from Accept dashboard > Settings > Account Info
ACCEPT_API_KEY=
ACCEPT_INTEGRATION_ID=
ACCEPT_BASE_URL=https://accept.paymob.com/api

# Aramex Shipping API (Optional⚠️ - uses manual/mock mode in development)
# For REAL shipping with tracking numbers, get credentials from Aramex
# Without credentials, shipping runs in MANUAL/MOCK MODE (admin enters tracking manually)
# Sign up at: https://www.aramex.com/solutions/developers
# Coverage: Egypt, UAE, Saudi Arabia, Kuwait, Qatar, Bahrain, Oman, Jordan, Lebanon
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=DXB
ARAMEX_BASE_URL=https://ws.dev.aramex.net/ShippingAPI.V2

# Aramex Sender Address (Your Warehouse/Fulfillment Center)
# Required for real shipping - leave empty for manual mode
ARAMEX_SENDER_NAME=E-Commerce Platform
ARAMEX_SENDER_COMPANY=Your Company Name
ARAMEX_SENDER_ADDRESS1=123 Business Street
ARAMEX_SENDER_ADDRESS2=Suite 100
ARAMEX_SENDER_CITY=Dubai
ARAMEX_SENDER_STATE=Dubai
ARAMEX_SENDER_POSTAL_CODE=12345
ARAMEX_SENDER_COUNTRY=AE
ARAMEX_SENDER_PHONE=+971501234567
ARAMEX_SENDER_EMAIL=warehouse@yourcompany.com
