<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Include Spring Boot's default logback configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Define properties for log configuration -->
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}ecommerce.log}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    
    <!-- 
        Console Appender - Development Profile
        Uses pretty-printed JSON for better readability during development
    -->
    <springProfile name="dev,local,development">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Pretty print JSON for development readability -->
                <jsonGeneratorDecorator class="net.logstash.logback.decorate.PrettyPrintingJsonGeneratorDecorator"/>
                
                <!-- Include standard fields -->
                <includeCallerData>false</includeCallerData>
                <includeMdc>true</includeMdc>
                <includeContext>true</includeContext>
                <includeTags>true</includeTags>
                
                <!-- Custom field names for better clarity -->
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>version</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                
                <!-- Custom JSON fields -->
                <customFields>{"application":"ecommerce","environment":"development"}</customFields>
                
                <!-- MDC fields that will be automatically included: requestId, userId, sessionId, ipAddress -->
            </encoder>
        </appender>
        
        <!-- Also keep traditional console output for backwards compatibility -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        
        <!-- Application-specific loggers -->
        <logger name="com.ecommerce" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
    </springProfile>
    
    <!-- 
        Console Appender - Production Profile
        Uses compact JSON (single-line) for efficient log aggregation and parsing
    -->
    <springProfile name="prod,production">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Compact JSON (single-line) for production -->
                <includeCallerData>false</includeCallerData>
                <includeMdc>true</includeMdc>
                <includeContext>true</includeContext>
                <includeTags>true</includeTags>
                
                <!-- Custom field names -->
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>version</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                
                <!-- Custom JSON fields -->
                <customFields>{"application":"ecommerce","environment":"production"}</customFields>
                
                <!-- MDC fields automatically included: requestId, userId, sessionId, ipAddress -->
            </encoder>
        </appender>
        
        <!-- File Appender - Production rotating logs -->
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <!-- Daily rollover -->
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.gz</fileNamePattern>
                <!-- Keep 30 days of history -->
                <maxHistory>30</maxHistory>
                <!-- Total size of all log files -->
                <totalSizeCap>5GB</totalSizeCap>
            </rollingPolicy>
            
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeCallerData>false</includeCallerData>
                <includeMdc>true</includeMdc>
                <includeContext>true</includeContext>
                <includeTags>true</includeTags>
                
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>version</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                
                <customFields>{"application":"ecommerce","environment":"production"}</customFields>
            </encoder>
        </appender>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </root>
        
        <!-- Application-specific loggers -->
        <logger name="com.ecommerce" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        
        <!-- Security-related events should be logged even at higher verbosity -->
        <logger name="com.ecommerce.shared.security" level="INFO"/>
        <logger name="com.ecommerce.auth" level="INFO"/>
    </springProfile>
    
    <!-- 
        Async Appender - Optional performance optimization
        Wraps other appenders to prevent logging from blocking application threads
    -->
    <springProfile name="prod,production">
        <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="CONSOLE_JSON"/>
        </appender>
        
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="FILE_JSON"/>
        </appender>
    </springProfile>
    
    <!-- 
        Specific logger configurations for noisy libraries
        These prevent excessive logging from third-party dependencies
    -->
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.data" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="org.springframework.boot.actuate" level="INFO"/>
    
</configuration>
